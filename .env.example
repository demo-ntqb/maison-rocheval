# Shopify Headless sales channel
# Keep the private token server-only. The project falls back to mock.shop when
# these two values are empty so local development and CI can build without secrets.
PRIVATE_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Reserved for browser-side Storefront API features such as predictive search.
# Do not use this token for server-side catalog queries.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Used to validate Shopify webhook HMAC signatures server-side.
SHOPIFY_ADMIN_CLIENT_SECRET=

# Canonical storefront URL used by metadata, sitemap and Customer Account OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ORIGIN=http://localhost:3000

# Secret token used to authorize manual on-demand cache revalidation (/api/revalidate).
# REQUIRED for the endpoint to work — the route refuses to serve (503) when unset,
# and never falls back to a built-in default. If empty, falls back to SHOPIFY_ADMIN_CLIENT_SECRET.
# Pass it via the Authorization Bearer header or x-revalidate-secret — never via a query string.
REVALIDATE_SECRET_TOKEN=

# US priority-access PIN. Keep this server-only; rotating it invalidates access cookies.
ACCESS_GATE_PIN_US=
# Separate HMAC key for the cookie grant; use a long random value in production.
ACCESS_GATE_SECRET=

NEXT_PUBLIC_GOOGLE_ANALYTIC_ID=

# Phase 2: cart/account/analytics. Leave empty until those features are enabled.
SESSION_SECRET=
NEXT_PUBLIC_SHOPIFY_SHOP_ID=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID=
NEXT_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# Resend — powers the contact form (src/screens/contact). Both are REQUIRED for
# submissions to send; the server action refuses (and logs) if either is unset.
RESEND_API_KEY=
# Inbox that receives contact form submissions.
CONTACT_EMAIL_TO=
# Must be a verified sender/domain in Resend. Defaults to Resend's shared test
# sender (onboarding@resend.dev) if unset, which only delivers to your own
# Resend account email — fine for local dev, not for production.
RESEND_FROM_EMAIL=

# Upstash Redis — rate-limits the contact form (3 submissions / 10 min per IP).
# OPTIONAL but strongly recommended in production: the app is deployed across
# multiple serverless instances, so an in-memory limiter would not be shared
# between them. If unset, the form falls back to unlimited submissions and
# logs a warning — it never blocks sending because of this being unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
